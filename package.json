{
  "name": "gmusic-guitarra-interactiva",
  "version": "1.1.0",
  "private": true,
  "description": "Aprendizaje interactivo de guitarra con audio y progreso local.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test test/*.js",
    "check:static": "node scripts/check.mjs",
    "check": "npm run check:static && npm run check:vendor && npm test",
    "vendor:tonal": "node scripts/vendor-tonal.mjs",
    "check:vendor": "node scripts/vendor-tonal.mjs --check"
  },
  "dependencies": {
    "tonal": "6.4.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
